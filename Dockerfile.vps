# VPS temporária (D66b, 31/10/2026, autorizada pelo Caio): o mesmo portal, lendo o espelho dos dados (espelho/, gerado
# por tools/gerar_espelho.py) em vez do BigQuery. Sem credencial do GCP na imagem. Link aberto só com a chave
# (CHAVE_ACESSO, definida no painel da VPS), só leitura (AUTH=publico). Sai do ar quando o link restrito for liberado.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=America/Sao_Paulo \
    DEV=false \
    AUTH=publico \
    MODO=apresentacao \
    CORTE_DADOS=off \
    PREVISAO_JOB=off \
    ESPELHO_DIR=/app/espelho \
    INICIATIVAS_BACKEND=sqlite \
    INICIATIVAS_DB=/tmp/iniciativas/iniciativas.db \
    INICIATIVAS_ANEXOS=/tmp/iniciativas/anexos

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app/ ./app/
COPY ml/saida/previsao.json ./ml/saida/previsao.json
COPY espelho/ ./espelho/

RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8080
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
